# Kalshi API credentials — generate at kalshi.com account settings (API keys).
# The private key file is downloaded once at key creation; store it outside git.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=~/.kalshi/kalshi-private-key.pem

# Demo environment uses separate credentials — generate at demo.kalshi.co.
KALSHI_DEMO_API_KEY_ID=
KALSHI_DEMO_PRIVATE_KEY_PATH=~/.kalshi/keys/demo/demo-key.pem

# Optional: the-odds-api.com key, sportsbook lines for sports_devig (free tier
# is 500 credits/month). Leave blank to disable that strategy's data source.
ODDS_API_KEY=

# demo | paper | live  — execution mode. "live" additionally requires LIVE_TRADING_ACK=yes
TRADING_MODE=paper
LIVE_TRADING_ACK=no

# Risk limits (dollars)
MAX_POSITION_PER_MARKET=50
MAX_DAILY_LOSS=25
MAX_TOTAL_EXPOSURE=300
